def ordinal(n):
    if n % 100 in (11, 12, 13):
        return n, "th"
    return n, {1: "st", 2: "nd", 3: "rd"}.get(n % 10, "th")
print("Ordinal Number\nketik 0 untuk mengentikan program")
n = None
while n != 0:
    n = int(input("masukkan angka: "))
    print(ordinal(n))
print("terima kasih telah menggunakan program saya")